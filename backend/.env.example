# Puerto del API (opcional — solo desarrollo local)
PORT=3000
HOST=127.0.0.1

# Firebase Web API Key (Identity Toolkit / Auth REST)
# Firebase Console → Project settings → General → Your apps
FIREBASE_API_KEY=tu_firebase_web_api_key

# Firebase Admin (producción / Vercel)
# Pega el JSON completo de la service account en una sola línea,
# o su versión en Base64. No subas serviceAccountKey.json al repo.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# Upstash Redis (opcional — caché distribuida)
# Sin estas variables la app sigue funcionando con Firestore
UPSTASH_REDIS_REST_URL=https://tu-instancia.upstash.io
UPSTASH_REDIS_REST_TOKEN=tu_upstash_token

# Pabilo — pagos móviles / verificación bancaria (opcional)
PABILO_API_KEY=tu_pabilo_api_key

# Google Gemini (BaiFy AI chat)
# Google AI Studio → Get API key. Nunca subas la clave real al repo.
GOOGLE_GENERATIVE_AI_API_KEY=tu_google_generative_ai_api_key
# Modelo Gemini (default: gemini-3.6-flash — requerido para cuentas nuevas en AI Studio)
# GEMINI_MODEL=gemini-3.6-flash
# Plan free: cuota limitada (~20 req/min por modelo); cada mensaje con tools = varias req.
# https://ai.google.dev/gemini-api/docs/rate-limits

# Límite BaiFy: mensajes por usuario Firebase (uid) por día (default 20).
# Redis (Upstash) si está configurado; si no, Firestore en baify_ai_message_limits.
# BAIFY_AI_MAX_USER_MESSAGES_PER_DAY=20
# Ráfaga por minuto (opcional, default 4)
# BAIFY_AI_MAX_USER_MESSAGES_PER_MIN=4

# Plan free: desactiva tools (1 llamada Gemini/msg, sin datos en vivo). Valores: 0 = off
# BAIFY_AI_ENABLE_TOOLS=0

# Modo free tier en prompt (default activo si no defines la variable).
# Con API key de proyecto facturado / crédito (ej. $5 en AI Studio), usa:
# BAIFY_AI_FREE_TIER=0
# BAIFY_AI_MAX_TOOL_CALLS=4
# BAIFY_AI_MAX_USER_MESSAGES_PER_MIN=8
# (Opcional) sigue en 1 con tools activas:
# BAIFY_AI_ENABLE_TOOLS=1

# Debug: log de tools invocadas en BaiFy AI chat (opcional)
# BAIFY_AI_DEBUG=1

# Debug: medir lecturas de Firestore (opcional)
# METER_FIRESTORE_READS=1
