# Puerto del API (opcional — solo desarrollo local)
PORT=3000
HOST=127.0.0.1

# Firebase Web API Key (Identity Toolkit / Auth REST)
# Firebase Console → Project settings → General → Your apps
FIREBASE_API_KEY=tu_firebase_web_api_key

# Firebase Admin (producción / Vercel)
# Pega el JSON completo de la service account en una sola línea,
# o su versión en Base64. No subas serviceAccountKey.json al repo.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# Upstash Redis (opcional — caché distribuida)
# Sin estas variables la app sigue funcionando con Firestore
UPSTASH_REDIS_REST_URL=https://tu-instancia.upstash.io
UPSTASH_REDIS_REST_TOKEN=tu_upstash_token

# Pabilo — pagos móviles / verificación bancaria (opcional)
PABILO_API_KEY=tu_pabilo_api_key

# Debug: medir lecturas de Firestore (opcional)
# METER_FIRESTORE_READS=1
